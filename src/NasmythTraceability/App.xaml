<Application x:Class="NasmythTraceability.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NasmythTraceability.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkBlueTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:BoolToBrushConverter x:Key="BoolToBrush" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <conv:FractionToWidthConverter x:Key="FractionToWidth" />
            <conv:EnumMatchConverter x:Key="EnumMatch" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
