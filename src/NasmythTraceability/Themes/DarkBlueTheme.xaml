<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ Dark Blue palette ============ -->
    <Color x:Key="AppBackgroundColor">#FF0A1B33</Color>
    <Color x:Key="AppSurfaceColor">#FF12294A</Color>
    <Color x:Key="AppSurfaceAltColor">#FF0E2140</Color>
    <Color x:Key="AppHeaderColor">#FF0C233F</Color>
    <Color x:Key="AppBorderColor">#FF20406A</Color>
    <Color x:Key="AppTextPrimaryColor">#FFEAF2FC</Color>
    <Color x:Key="AppTextSecondaryColor">#FF9DB4CE</Color>
    <Color x:Key="AppAccentColor">#FF1E88E5</Color>
    <Color x:Key="AppAccentDarkColor">#FF1565C0</Color>
    <Color x:Key="AppOkColor">#FF2ECC71</Color>
    <Color x:Key="AppOkDarkColor">#FF27AE60</Color>
    <Color x:Key="AppNgColor">#FFE74C3C</Color>
    <Color x:Key="AppWarnColor">#FFF1C40F</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAltColor}" />
    <SolidColorBrush x:Key="AppHeaderBrush" Color="{StaticResource AppHeaderColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentDarkBrush" Color="{StaticResource AppAccentDarkColor}" />
    <SolidColorBrush x:Key="AppOkBrush" Color="{StaticResource AppOkColor}" />
    <SolidColorBrush x:Key="AppOkDarkBrush" Color="{StaticResource AppOkDarkColor}" />
    <SolidColorBrush x:Key="AppNgBrush" Color="{StaticResource AppNgColor}" />
    <SolidColorBrush x:Key="AppWarnBrush" Color="{StaticResource AppWarnColor}" />

    <!-- Chart series palette -->
    <SolidColorBrush x:Key="Series1Brush" Color="#FF1E88E5" />
    <SolidColorBrush x:Key="Series2Brush" Color="#FF2ECC71" />
    <SolidColorBrush x:Key="Series3Brush" Color="#FF00BCD4" />
    <SolidColorBrush x:Key="Series4Brush" Color="#FFF1C40F" />
    <SolidColorBrush x:Key="Series5Brush" Color="#FF9B59B6" />

    <sys:Double x:Key="AppBaseFontSize">14</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

</ResourceDictionary>
