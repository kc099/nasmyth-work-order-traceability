<Window x:Class="NasmythTraceability.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrator password"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBlock Text="Administrator password" Style="{StaticResource Caption}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInput" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppNgBrush}" FontSize="12"
                   Margin="0,6,0,0" Visibility="Collapsed" Text="Wrong password." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Delete" IsDefault="True" MinWidth="90" Style="{StaticResource AccentButton}"
                    Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
