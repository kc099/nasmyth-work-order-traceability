<UserControl x:Class="NasmythTraceability.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NasmythTraceability.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="760" d:DesignWidth="1080">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Live Station Monitoring" Style="{StaticResource H1}" Margin="4,0,0,10" />

        <!-- Main split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Live scan log -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Live Scan Log" Style="{StaticResource H2}" />
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" Padding="12,4" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LiveScanLog}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90" />
                            <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="80" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="110" />
                            <DataGridTextColumn Header="Work Order" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTemplateColumn Header="Result" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding Result, Converter={StaticResource StatusToBrush}}">
                                            <TextBlock Text="{Binding Result}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Work Order Search" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button Content="Search" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                    Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                            <Grid>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnSearchBoxKeyDown" LostKeyboardFocus="OnSearchBoxLostFocus" />
                                <TextBlock Text="Type part of a work order or tag number"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" />

                                <!-- Matches as you type: arrow keys + Enter, or click, to pick one -->
                                <Popup PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="4"
                                       IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}" StaysOpen="False"
                                       AllowsTransparency="True" Focusable="False"
                                       Width="{Binding ActualWidth, ElementName=SearchBox}">
                                    <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="4">
                                        <ListBox ItemsSource="{Binding Suggestions}"
                                                 SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                                 MaxHeight="400" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSuggestionClicked" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="10,6">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource AppAccentDarkBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding WorkOrder}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding TagText}" FontSize="11"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                       Visibility="{Binding TagText, Converter={StaticResource EmptyToVisibility}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Scan Information" Style="{StaticResource H2}" />
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Style="{StaticResource OkButton}" Padding="12,6"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static vm:AppPage.Reports}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View Reports &amp; Analytics" />
                                    <TextBlock Text="  &#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Work Order" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentBarcode}" Margin="12,3,0,3" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Station" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentStation}" Margin="12,3,0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Style="{StaticResource Caption}" Margin="0,3" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="12,3,0,3">
                                <Border CornerRadius="4" Padding="8,2"
                                        Background="{Binding CurrentResult, Converter={StaticResource StatusToBrush}}">
                                    <TextBlock Text="{Binding CurrentResult}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding CurrentStatus}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Scan Time" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentLastScan}" Margin="12,3,0,3" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="History" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="80" />
                                <DataGridTextColumn Header="Time In" Binding="{Binding DateTimeText}" Width="*" />
                                <DataGridTextColumn Header="Time Out" Binding="{Binding ExitText}" Width="*" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="64" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
