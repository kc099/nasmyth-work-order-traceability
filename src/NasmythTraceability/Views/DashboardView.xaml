<UserControl x:Class="NasmythTraceability.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NasmythTraceability.ViewModels"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="760" d:DesignWidth="1080">

    <UserControl.Resources>
        <DataTemplate x:Key="StationTileTemplate" DataType="{x:Type vm:StationTileViewModel}">
            <Border CornerRadius="10" Padding="16" Margin="6" BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF1E7F45" Offset="0" />
                                            <GradientStop Color="#FF176B3A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="{Binding Code}" FontSize="20" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="FINAL" FontSize="10" FontWeight="Bold" Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsFinal, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#DDFFFFFF" Margin="0,4,0,10"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="2">
                        <StackPanel>
                            <TextBlock Text="Scans (session)" FontSize="10" Foreground="#AAFFFFFF" />
                            <TextBlock Text="{Binding SessionScans}" FontSize="16" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="Last scan" FontSize="10" Foreground="#AAFFFFFF" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LastScanText}" FontSize="14" Foreground="White" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Live Station Monitoring" Style="{StaticResource H1}" Margin="4,0,0,10" />

        <!-- Station tiles -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding StationTiles}"
                      ItemTemplate="{StaticResource StationTileTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <prim:UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Main split -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Live scan log -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Live Scan Log" Style="{StaticResource H2}" />
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" Padding="12,4" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LiveScanLog}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90" />
                            <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="80" />
                            <DataGridTextColumn Header="Work Order" Binding="{Binding Barcode}" Width="*" />
                            <DataGridTemplateColumn Header="Result" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding Result, Converter={StaticResource StatusToBrush}}">
                                            <TextBlock Text="{Binding Result}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="8"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MANUAL / TEST SCAN" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Station" VerticalAlignment="Center" Style="{StaticResource Caption}"
                                           Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" Height="36" ItemsSource="{Binding ManualStations}"
                                          SelectedItem="{Binding SelectedManualStation}"
                                          ItemTemplate="{StaticResource StationCodeItemTemplate}" />

                                <Grid Grid.Column="2" Margin="10,0">
                                    <TextBox x:Name="SimBox" Height="36"
                                             Text="{Binding SimulateBarcode, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SimulateScanCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="Type a work order, then press Enter or Simulate"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SimBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="3" Content="Simulate" MinWidth="110" Height="36"
                                        Style="{StaticResource AccentButton}" Command="{Binding SimulateScanCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Work Order Search" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button Content="Search" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                    Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Current Information" Style="{StaticResource H2}" />
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Style="{StaticResource OkButton}" Padding="12,6"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static vm:AppPage.Reports}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View Reports &amp; Analytics" />
                                    <TextBlock Text="  &#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Work Order" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentBarcode}" Margin="12,3,0,3" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Station" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentStation}" Margin="12,3,0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Style="{StaticResource Caption}" Margin="0,3" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="12,3,0,3">
                                <Border CornerRadius="4" Padding="8,2"
                                        Background="{Binding CurrentResult, Converter={StaticResource StatusToBrush}}">
                                    <TextBlock Text="{Binding CurrentResult}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding CurrentStatus}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Scan Time" Style="{StaticResource Caption}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentLastScan}" Margin="12,3,0,3" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="History" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding DateTimeText}" Width="*" />
                                <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="90" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
