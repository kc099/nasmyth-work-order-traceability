<UserControl x:Class="NasmythTraceability.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NasmythTraceability.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="760" d:DesignWidth="1120">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="Settings" Style="{StaticResource H1}" VerticalAlignment="Center" />

            <!-- Edit lock: one password unlocks all changes on this screen -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Locked - enter password to edit" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <PasswordBox x:Name="UnlockPassword" Width="180">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding UnlockCommand}"
                                        CommandParameter="{Binding ElementName=UnlockPassword}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <Button Content="Unlock" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding UnlockCommand}" CommandParameter="{Binding ElementName=UnlockPassword}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppOkBrush}" />
                    <TextBlock Text="Unlocked" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="New password" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <PasswordBox x:Name="NewPassword" Width="160" />
                    <Button Content="Change password" Margin="8,0,0,0"
                            Command="{Binding ChangePasswordCommand}" CommandParameter="{Binding ElementName=NewPassword}" />
                    <Button Content="Lock" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding LockCommand}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" Margin="4,0" SelectedIndex="{Binding SettingsTabIndex}">
            <!-- ================= Stations (each with its network reader) ================= -->
            <TabItem Header="Stations">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                  IsReadOnly="{Binding IsUnlocked, Converter={StaticResource InverseBool}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="90" />
                                <DataGridTextColumn Header="Reader IP address" Binding="{Binding ReaderIp}" Width="170" />
                                <DataGridTemplateColumn Header="Reader status" Width="1.3*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{Binding ReaderStateKey, Converter={StaticResource StatusToBrush}}" />
                                                <TextBlock Text="{Binding ReaderStatus}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ReaderStatus}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80" />
                                <DataGridCheckBoxColumn Header="Final" Binding="{Binding IsFinal}" Width="64" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save changes" Style="{StaticResource AccentButton}"
                                    Command="{Binding SaveStationsCommand}" Margin="0,0,8,0" />
                            <Button Content="Set as final" Command="{Binding SetFinalStationCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete" Command="{Binding DeleteStationCommand}" />
                            <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="14,2" />
                            <Button Content="Test reader" Style="{StaticResource OkButton}" MinWidth="110"
                                    Command="{Binding TestStationReaderCommand}" />
                        </StackPanel>

                        <!-- Add a station, with the IP address of its reader -->
                        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource AppSurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="Add station" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Code" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding NewStationCode, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                 CharacterCasing="Upper" IsEnabled="{Binding IsUnlocked}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding NewStationName, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                                 IsEnabled="{Binding IsUnlocked}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Reader IP address" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding NewStationIp, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="170" IsEnabled="{Binding IsUnlocked}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddStationCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <Button Content="Test" Command="{Binding TestNewStationReaderCommand}" VerticalAlignment="Bottom"
                                            Margin="0,0,8,0" MinWidth="70" />
                                    <Button Content="Add station" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                                            Command="{Binding AddStationCommand}" MinWidth="110" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Each production station has one network RFID reader, polled at its IP address (give it a DHCP reservation so it never changes). Readers are polled all the time, whatever page is open, and are kept in read mode. The station marked Final is the last one: a scan there completes the work order." />
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= Work order assigning station ================= -->
            <TabItem Header="Assignment Station">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Work order assigning station" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="A separate reader used only on the Tag Assignment page, to write a work order to a tag. Its taps are never recorded as station scans, and it is not part of the production sequence." />

                        <TextBlock Text="Reader IP address" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding AssignmentIp, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                     IsEnabled="{Binding IsUnlocked}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SaveAssignmentStationCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Save" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"
                                    Command="{Binding SaveAssignmentStationCommand}" />
                            <Button Content="Test reader" Style="{StaticResource OkButton}" Margin="8,0,0,0"
                                    Command="{Binding TestAssignmentReaderCommand}" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Style="{StaticResource Caption}" Margin="0,3,16,3" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding AssignmentStatusKey, Converter={StaticResource StatusToBrush}}" />
                                <TextBlock Text="{Binding AssignmentStatusText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reader MAC" Style="{StaticResource Caption}" Margin="0,3,16,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="{Binding AssignmentMac}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssignmentMac}" Value="">
                                                <Setter Property="Text" Value="Not seen yet" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ================= Database ================= -->
            <TabItem Header="Database">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Database file (SQLite3)" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Backup..." Style="{StaticResource AccentButton}"
                                    Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,0" />
                            <Button Content="Restore..." Command="{Binding RestoreDatabaseCommand}" Margin="0,0,8,0" />
                            <Button Content="Open folder" Command="{Binding OpenDatabaseFolderCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Restore replaces all current data with the selected backup. Take a backup first." />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="4,10,4,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource AppSurfaceAltBrush}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
