<UserControl x:Class="NasmythTraceability.Views.TagAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NasmythTraceability.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TagAssignmentViewModel}"
             d:DesignHeight="760" d:DesignWidth="1120">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="Tag Assignment" Style="{StaticResource H1}" VerticalAlignment="Center" />

            <!-- Lock: assigning tags needs the administrator password -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Locked - enter password to assign tags" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <PasswordBox x:Name="UnlockPassword" Width="180">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding UnlockCommand}"
                                        CommandParameter="{Binding ElementName=UnlockPassword}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <Button Content="Unlock" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding UnlockCommand}" CommandParameter="{Binding ElementName=UnlockPassword}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppOkBrush}" />
                    <TextBlock Text="Unlocked" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Lock" Style="{StaticResource AccentButton}" Command="{Binding LockCommand}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- What the readers are doing right now -->
        <Border Grid.Row="1" Margin="4,0,4,10" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource AppSurfaceAltBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AppWarnBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text"
                                Value="This page is locked. Enter the administrator password to assign tags. Until then the readers keep recording station scans as usual." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                <Setter Property="Text"
                                        Value="Assignment mode is on: a tag tapped on any reader is read here and is NOT recorded as a station scan. Lock or leave this page to go back to tracking." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="2" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- Assign a tag to a work order -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Assign Tag to Work Order" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <TextBlock Text="1. Tag ID (tap the tag on a reader)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TagId, UpdateSourceTrigger=PropertyChanged}" Height="36" FontWeight="SemiBold"
                             IsEnabled="{Binding IsUnlocked}" />
                    <TextBlock Text="{Binding TagInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,14" />

                    <TextBlock Text="2. Work order number (letters and digits)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}" Height="36"
                             CharacterCasing="Upper" MaxLength="40" IsEnabled="{Binding IsUnlocked}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AssignCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Assign" Style="{StaticResource AccentButton}" MinWidth="110"
                                Command="{Binding AssignCommand}" Margin="0,0,8,0" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="After assigning, lock or leave this page and tap the tag at the first station to record its entry, then at the final station to complete the work order." />
                </StackPanel>
            </Border>

            <!-- Existing assignments -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Assigned Tags" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="Search" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Assignments}"
                              SelectedItem="{Binding SelectedAssignment}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag ID" Binding="{Binding TagId}" Width="150" />
                            <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrder}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120" />
                            <DataGridTextColumn Header="Station" Binding="{Binding StationCode}" Width="80" />
                            <DataGridTextColumn Header="Assigned on" Binding="{Binding AssignedText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Remove assignment" Command="{Binding RemoveAssignmentCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Margin="4,10,4,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource AppSurfaceAltBrush}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
