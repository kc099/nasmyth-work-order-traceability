<UserControl x:Class="NasmythTraceability.Views.TagAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NasmythTraceability.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TagAssignmentViewModel}"
             d:DesignHeight="760" d:DesignWidth="1120">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="Tag Assignment" Style="{StaticResource H1}" VerticalAlignment="Center" />

            <!-- Lock: assigning tags needs the administrator password -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Locked - enter password to assign tags" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <PasswordBox x:Name="UnlockPassword" Width="180">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding UnlockCommand}"
                                        CommandParameter="{Binding ElementName=UnlockPassword}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <Button Content="Unlock" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding UnlockCommand}" CommandParameter="{Binding ElementName=UnlockPassword}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppOkBrush}" />
                    <TextBlock Text="Unlocked" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Lock" Style="{StaticResource AccentButton}" Command="{Binding LockCommand}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- The assignment station's reader -->
        <Border Grid.Row="1" Margin="4,0,4,10" Padding="12,8" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{Binding ReaderStateKey, Converter={StaticResource StatusToBrush}}">
            <DockPanel>
                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{Binding ReaderStateKey, Converter={StaticResource StatusToBrush}}" />
                <TextBlock Text="{Binding ReaderText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- Write a work order to a tag -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Write Work Order to Tag" Style="{StaticResource H2}" Margin="0,0,0,12" />

                        <TextBlock Text="1. Work order number (4 to 16 letters and digits; - _ / . allowed inside)"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBox Text="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36" FontWeight="SemiBold" CharacterCasing="Upper"
                                 IsEnabled="{Binding IsWriting, Converter={StaticResource InverseBool}}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding WriteTagCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding WorkOrderHint}" FontSize="12" TextWrapping="Wrap" Margin="2,4,0,0"
                                   Foreground="{Binding WorkOrderHintKey, Converter={StaticResource StatusToBrush}}"
                                   Visibility="{Binding WorkOrderHint, Converter={StaticResource EmptyToVisibility}}" />

                        <TextBlock Text="2. Press Write to tag, then present the tag on the assignment station's reader"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Write to tag" Style="{StaticResource AccentButton}" MinWidth="130"
                                    Command="{Binding WriteTagCommand}" Margin="0,0,8,0" />
                            <Button Content="Cancel" Command="{Binding CancelWriteCommand}" MinWidth="90" />
                        </StackPanel>

                        <!-- Write status -->
                        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8" BorderThickness="2"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                BorderBrush="{Binding WriteStateKey, Converter={StaticResource StatusToBrush}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountdownText}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppWarnBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"
                                               Foreground="{Binding WriteStateKey, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="Status" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WriteStateKey}" Value="WARN">
                                                        <Setter Property="Text" Value="Waiting for tag..." />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WriteStateKey}" Value="OK">
                                                        <Setter Property="Text" Value="Tag written" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WriteStateKey}" Value="NG">
                                                        <Setter Property="Text" Value="Not written" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding WriteMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- A tag presented outside a write -->
                        <TextBlock Text="Last tag at the assignment station" Style="{StaticResource Caption}" Margin="0,18,0,4" />
                        <TextBlock Text="{Binding LastTagId}" FontWeight="SemiBold"
                                   Visibility="{Binding LastTagId, Converter={StaticResource EmptyToVisibility}}" />
                        <TextBlock Text="{Binding LastTagInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,18,0,0"
                                   Text="The production station readers keep recording scans while this page is open. After writing, tap the tag at the first station to record its entry, then at the final station to complete the work order." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Existing assignments -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Assigned Tags" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="Search" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Assignments}"
                              SelectedItem="{Binding SelectedAssignment}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag UID" Binding="{Binding TagId}" Width="150" />
                            <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrder}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120" />
                            <DataGridTextColumn Header="Station" Binding="{Binding StationCode}" Width="80" />
                            <DataGridTextColumn Header="Assigned on" Binding="{Binding AssignedText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Remove assignment" Command="{Binding RemoveAssignmentCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Margin="4,10,4,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource AppSurfaceAltBrush}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
