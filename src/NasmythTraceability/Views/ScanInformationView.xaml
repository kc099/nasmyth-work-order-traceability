<UserControl x:Class="NasmythTraceability.Views.ScanInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NasmythTraceability.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="760" d:DesignWidth="1120">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="Scan Information" Style="{StaticResource H1}" />
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource Caption}">
                <Run Text="{Binding InProgressCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <Run Text=" in progress    " />
                <Run Text="{Binding CompletedCount, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <Run Text=" completed" />
            </TextBlock>
        </DockPanel>

        <Grid Grid.Row="1" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Which work order is at which station right now -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scans" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Station" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PositionStationOptions}"
                                  SelectedItem="{Binding PositionStationFilter}" />
                        <TextBox Grid.Column="2" Margin="8,0" Text="{Binding PositionSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding RefreshPositionsCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshPositionsCommand}" />
                    </Grid>

                    <TabControl Grid.Row="2">
                        <TabItem Header="Scanned Work Orders">
                            <DataGrid ItemsSource="{Binding CurrentPositions}" Margin="0,8,0,0"
                                      SelectedItem="{Binding SelectedPosition}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Work Order" Binding="{Binding Barcode}" Width="*" />
                                    <DataGridTextColumn Header="Station" Binding="{Binding StationCode}" Width="80" />
                                    <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="StatusText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                        Background="{Binding StatusText, Converter={StaticResource StatusToBrush}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" Width="64" />
                                    <DataGridTextColumn Header="Scans" Binding="{Binding ScanCount}" Width="60" />
                                    <DataGridTextColumn Header="Last Scan" Binding="{Binding LastScanText}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Taps that were not recorded as a station visit -->
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock>
                                    <Run Text="Invalid &amp; Repeat Scans (" /><Run Text="{Binding ScanExceptions.Count, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </TabItem.Header>
                            <DockPanel Margin="0,8,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Show" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding ExceptionKindOptions}" SelectedItem="{Binding ExceptionKind}" Width="170" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="Invalid: tag not assigned, out of sequence, blocked or already completed. Repeat: tapped again at the station it is already at. Newest first." />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding ScanExceptions}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="140" />
                                        <DataGridTextColumn Header="Station" Binding="{Binding StationText}" Width="70" />
                                        <DataGridTextColumn Header="Tag" Binding="{Binding TagId}" Width="110" />
                                        <DataGridTextColumn Header="Work Order" Binding="{Binding RawData}" Width="120" />
                                        <DataGridTemplateColumn Header="Type" Width="80" SortMemberPath="KindText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                            Background="{Binding KindKey, Converter={StaticResource StatusToBrush}}">
                                                        <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Selected work order: status + full history -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Scan Details" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="{Binding CurrentBarcode}" FontSize="18" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Current station" Style="{StaticResource Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentStation}" Margin="12,3,0,3" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource Caption}" Margin="0,3" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12,3,0,3">
                            <Border CornerRadius="4" Padding="8,2"
                                    Background="{Binding CurrentResult, Converter={StaticResource StatusToBrush}}">
                                <TextBlock Text="{Binding CurrentResult}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding CurrentStatus}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Last scan" Style="{StaticResource Caption}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentLastScan}" Margin="12,3,0,3" />
                    </Grid>

                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Text="Scan History" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding History}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="70" />
                                <DataGridTextColumn Header="Time In" Binding="{Binding DateTimeText}" Width="140" />
                                <DataGridTextColumn Header="Time Out" Binding="{Binding ExitText}" Width="140" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="60" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Correcting a mistake - both ask for the administrator password -->
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Delete last scan" Command="{Binding DeleteLastScanCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete all scans of this work order" Command="{Binding DeleteWorkOrderScansCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Use these to correct a wrong scan, for example a tag tapped at the final station first. The administrator password is required." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
